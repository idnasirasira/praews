[PHP]
engine = On
short_open_tag = Off
precision = 14
output_buffering = 4096
zlib.output_compression = Off
implicit_flush = Off
serialize_precision = -1
zend.enable_gc = On
expose_php = On

; Resource Limits — visual defaults (overridden below from UI)
max_execution_time = 300
max_input_time = 300
memory_limit = 512M

; Error Handling & Logging
error_reporting = E_ALL
display_errors = On
display_startup_errors = On
log_errors = On
error_log = "{{ app_root }}/logs/php_error.log"

; File Uploads & Post Data
post_max_size = 128M
file_uploads = On
upload_tmp_dir = "{{ app_root }}/temp/php/uploads"
upload_max_filesize = 128M
max_file_uploads = 20

{% if is_windows %}
; Windows NTS builds ship shared DLLs under ext/
extension_dir = "{{ app_root }}/bin/php/{{ php_version }}/ext"
zend_extension=opcache
{% else %}
; macOS/Linux static-php builds compile extensions into the binary.
; Do NOT enable extension= / zend_extension= here or PHP will warn about missing .so files.
{% endif %}

[Date]
date.timezone = "{{ timezone }}"

[Session]
session.save_handler = files
session.save_path = "{{ app_root }}/temp/php/sessions"
session.use_strict_mode = 0
session.use_cookies = 1
session.use_only_cookies = 1
session.name = PHPSESSID

[curl]
curl.cainfo = "{{ app_root }}/conf/ssl/cacert.pem"

[openssl]
openssl.cafile = "{{ app_root }}/conf/ssl/cacert.pem"

[opcache]
opcache.enable=1
opcache.enable_cli=1
opcache.memory_consumption=128
opcache.interned_strings_buffer=8
opcache.max_accelerated_files=10000
opcache.revalidate_freq=0

; --- VISUAL TUNING SETTINGS (Dikontrol dari UI) ---
max_execution_time = {{ php_settings.max_execution_time }}
max_input_time = {{ php_settings.max_input_time }}
memory_limit = {{ php_settings.memory_limit }}
post_max_size = {{ php_settings.post_max_size }}
upload_max_filesize = {{ php_settings.upload_max_filesize }}
display_errors = {% if php_settings.display_errors %}On{% else %}Off{% endif %}

{% if is_windows %}
; --- DYNAMIC EXTENSIONS (Dikontrol dari Checkbox UI) ---
{% for ext in php_settings.enabled_extensions %}
extension={{ ext }}
{% endfor %}
{% endif %}

; =====================================================================
; USER CUSTOM OVERRIDES (Dari conf/custom/php_custom.ini - Aman dari Overwrite)
; =====================================================================
{{ php_custom_raw }}
