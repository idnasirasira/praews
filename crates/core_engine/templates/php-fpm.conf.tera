[global]
pid = {{ app_root }}/temp/php/php-fpm.pid
error_log = {{ app_root }}/logs/php-fpm.log
daemonize = no

[www]
listen = 127.0.0.1:{{ php_fastcgi_port }}
listen.allowed_clients = 127.0.0.1
; Run as the launching user (portable local server — never needs root)
pm = dynamic
pm.max_children = 10
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
clear_env = no
catch_workers_output = yes
php_admin_value[error_log] = {{ app_root }}/logs/php_error.log
php_admin_flag[log_errors] = on
