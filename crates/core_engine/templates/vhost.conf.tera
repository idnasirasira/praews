server {
    listen {{ http_port }};
    listen {{ https_port }} ssl;
    http2 on;
    server_name {{ domain }} *.{{ domain }};
    root "{{ project_public_path }}";
    index index.php index.html index.htm;

    ssl_certificate     "{{ app_root }}/conf/ssl/certs/{{ domain }}.crt";
    ssl_certificate_key "{{ app_root }}/conf/ssl/certs/{{ domain }}.key";
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log "{{ app_root }}/logs/{{ domain }}_access.log";
    error_log  "{{ app_root }}/logs/{{ domain }}_error.log";

    charset utf-8;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:{{ php_fastcgi_port }};
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include "{{ app_root }}/bin/nginx/conf/fastcgi_params";
        fastcgi_param HTTPS $https if_not_empty;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
